{
  "ci": {
    "collect": {
      "url": [
        "https://iltrenotideve.eu/",
        "https://iltrenotideve.eu/come-richiedere/",
        "https://iltrenotideve.eu/regole/",
        "https://iltrenotideve.eu/privacy/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci/live-desktop"
    }
  }
}
